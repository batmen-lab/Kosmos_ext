# ---------------------------------------------------------------------------
# Kosmos_ext: local runs, staged data and vendored copies
# ---------------------------------------------------------------------------
# Every `run.py` question writes a plan, a data report, figures, checkpoints
# and pseudo-label tensors under artifacts/runs; a few weeks of testing is
# 2 GB, and all of it is reproducible from the command that made it. The small
# hand-written fixtures (`artifacts/baseline_run`, `artifacts/model_comparison`)
# stay tracked.
artifacts/runs/

# Dated archive folders kept locally while the ppi/flow modules were rewritten
# (`archived/ppi-signed-v1-2026-09-13`, `archived/removed-2026-09-14`).
archived/*-20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# ToolUniverse is vendored into the workspace as a clone with its own .git
# (163 MB). It is a dependency, not this repository's history: commit it as a
# submodule, or delete its .git, before tracking it here.
ToolUniverse/

# What a fetch stages, in its own formats. Keyed by reference and re-created by
# `datafetcher fetch`, so none of it belongs in git.
data/**/*.h5ad
data/**/*.h5ad.gz
data/**/*.csv.gz
data/**/*.mtx
data/**/*.mtx.gz
data/**/*.tar
data/**/*.bw

# Model checkpoints, pseudo-label tensors and matrices: always generated.
*.npz
*.pt
*.pth
*.ckpt
*.onnx

# Crash dumps: a segfault inside torch/BLAS leaves a multi-gigabyte core file.
core
core.*
*.core
vgcore.*

# Caches and state written by the tooling that runs in this workspace.
.ruff_cache/
.codex/
.agents/
*.egg-info/

# The GEARS GO graph (355 MB, Harvard Dataverse file 6934319) and any other
# reference graph: staged data, re-downloadable, not history.
data/perturbation/reference/
data/
/data/

# ---------------------------------------------------------------------------
# Perturbation work (stage 1 survey, stage 2 prepare scripts, stage 3 runs)
# ---------------------------------------------------------------------------
# Tables and matrices a prepare script or a fetch writes, wherever it writes
# them (the rules above cover `data/` only): `Perturb_middle/output_*/*.parquet`
# alone is ~5 GB, and `artifacts/prepared/` 2 GB. The scripts re-create them.
*.parquet
*.npy
*.csv.gz
*.tsv.gz
*.txt.gz
*.mtx
*.mtx.gz
*.h5
*.h5ad
*.h5ad.gz
*.part

# Stage-2 / stage-3 outputs kept as text: `prepare_report.md`, `summary.md`,
# `data_report.md`, `report_run-*.md`, small json. Their heavy files are covered
# by the type rules above and by `*.pt`, `*.npz`, `*.png`, `*.jsonl` earlier.
artifacts/prepared/

# The old stage 1 (`kosmos dataprep`) wrote a 40-50 MB plan.json / reviews.json
# per run (a gene-panel profile of every table); `survey.md/json`, `gold_check.md`
# and `data.md` of a run stay trackable.
artifacts/dataprep/**/plan.json
artifacts/dataprep/**/reviews.json
artifacts/dataprep/**/search_trace.json
artifacts/dataprep/**/data_report.json

# Caches and state a run leaves behind.
.mypy_cache/
.hypothesis/
.cache/
lightning_logs/
wandb/
*.tfevents*
nohup.out
